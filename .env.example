# OnchainOS CLI credentials — required by every AEGIS skill at runtime.
# Copy this file to `.env`, fill in your sandbox or production values, and never commit `.env`.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Optional — overrides the default ~/.aegis runtime directory.
# AEGIS_HOME=/custom/path/.aegis

# Optional — overrides the config file path. Defaults to ./aegis.config.json then
# aegis.config.example.json.
# AEGIS_CONFIG=/custom/path/aegis.config.json
